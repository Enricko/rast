# RAST environment configuration example.
#
# Copy to /etc/rast/rast.env (0600 root:rast) or export these variables before
# starting rast.service. Every setting is optional; values shown are the
# built-in defaults unless noted.
#
# Precedence: built-in defaults < /etc/rast/rast.toml < RAST_* env < CLI flags.

# Listen address. Keep it on loopback when a reverse proxy terminates TLS.
RAST_BIND=127.0.0.1:8720

# Public base URL used for cookie security, CSRF origin checks and links.
# Set this to your HTTPS address in production.
#RAST_PUBLIC_URL=https://rast.example.com

# Configuration file location (default /etc/rast/rast.toml).
#RAST_CONFIG=/etc/rast/rast.toml

# Database/metadata directory. Must be on local storage with working locking.
RAST_DATA_DIR=/var/lib/rast

# Default location for user files, shared folders and the recycle bin.
RAST_STORAGE_DIR=/srv/rast

# Reverse proxies whose X-Forwarded-For / CF-Connecting-IP headers are trusted
# (comma separated CIDRs). Required when running behind nginx/Cloudflare.
#RAST_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Session lifetime in hours (sliding, absolute cap 30 days).
RAST_SESSION_TTL_HOURS=168

# Force the Secure cookie attribute. Auto-enabled when RAST_PUBLIC_URL is https.
#RAST_SECURE_COOKIES=true

# Resource monitor sampling interval in seconds (1-300).
RAST_MONITOR_INTERVAL_SECS=5

# Maximum size of a single uploaded file in bytes (default 10 GiB).
RAST_MAX_UPLOAD_BYTES=10737418240

# Default per-user storage quota in bytes (0 = unlimited).
RAST_DEFAULT_QUOTA_BYTES=21474836480

# SQLite connection pool size (1-64).
RAST_DB_MAX_CONNECTIONS=8

# Concurrent background jobs (1-8).
RAST_JOB_CONCURRENCY=2

# Unix socket for the privileged Docker worker.
RAST_WORKER_SOCKET=/run/rast/worker.sock

# Enable Docker application deployment management.
RAST_DOCKER_ENABLED=false

# Require `rast setup-token` before the web first-run setup is allowed.
RAST_SETUP_TOKEN_REQUIRED=true

# Log level: error, warn, info, debug, trace.
RAST_LOG_LEVEL=info

# Package Center ---------------------------------------------------------
# Signed catalog (https:// or a local file:/// mirror). Default: the official
# catalog published by Enricko/rast-packages.
#RAST_PACKAGES_CATALOG_URL=https://github.com/Enricko/rast-packages/releases/download/catalog/catalog.json
# Extra trusted catalog keys for a mirror you sign yourself, comma separated,
# each "<key-id>:<base64 Ed25519 public key>". The official key is built in.
#RAST_PACKAGES_CATALOG_KEYS=
# Automatic catalog/update check interval in minutes (0 disables, max 10080).
RAST_PACKAGES_CHECK_INTERVAL_MINUTES=360
# Optional GitHub token (read-only, public repos) to raise the API rate limit
# for "Install from GitHub". Keep it out of shared files.
#RAST_PACKAGES_GITHUB_TOKEN=
