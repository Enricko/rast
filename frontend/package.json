{
  "name": "rast-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RAST desktop web frontend (built with Vite + TypeScript, embedded into the Rust binary)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node tests/run.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  }
}
