{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Enricko/rast/main/docs/rast-package.schema.json",
  "title": "RAST package manifest (rast-package.json), schema version 1",
  "description": "Declarative description of one package version. RAST enforces these rules (and a few that JSON Schema cannot express, such as version ordering) in src/packages/manifest.rs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "type",
    "name",
    "publisher",
    "version",
    "revision",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "rast-package"
    },
    "id": {
      "description": "Stable package id. Lowercase letters, digits and dashes; must not end with a dash.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "not": {
        "enum": [
          "check",
          "consumers",
          "github",
          "host",
          "catalog",
          "bin"
        ]
      }
    },
    "type": {
      "description": "Package type: runtime installs commands; app installs a desktop app with an optional server RAST runs (official catalog only, RAST 0.9.17+); service is reserved for a later version.",
      "enum": [
        "runtime",
        "app"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "homepage": {
      "$ref": "#/$defs/httpsUrl"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "version": {
      "description": "Upstream version; also the install directory name.",
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9][0-9A-Za-z.+-]*$"
    },
    "revision": {
      "description": "Package revision of the same upstream version (rebuilds). Starts at 1.",
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "channel": {
      "description": "Update stream. Defaults to major.minor of the version (Node.js uses the major).",
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]{1,16}$"
    },
    "minRastVersion": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,3}"
    },
    "releaseDate": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "icon": {
      "description": "Package icon embedded as base64, shown in the RAST Package Center (runtimes) and App Center (apps). A signed catalog also carries the same object once per package as a package-level icon (it identifies the official runtimes); a manifest icon is optional. Validated by RAST: standard base64, decoded image 1 byte to 64 KiB, and SVG data must not contain scripts, foreignObject, event handlers, javascript: URLs or external http(s) hrefs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaType",
        "data"
      ],
      "properties": {
        "mediaType": {
          "description": "Image type; image/svg+xml or image/png.",
          "enum": [
            "image/svg+xml",
            "image/png"
          ]
        },
        "data": {
          "description": "Standard base64 (RFC 4648, with padding, no whitespace, no data: prefix) of the image. The decoded image is 1 byte to 65536 bytes (64 KiB); the base64 text therefore is 4 to 87380 characters.",
          "type": "string",
          "contentEncoding": "base64",
          "minLength": 4,
          "maxLength": 87380
        },
        "attribution": {
          "description": "Optional credit line, e.g. the icon source and license (the official catalog uses Devicon, MIT, and Simple Icons, CC0). At most 300 characters.",
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executables",
        "checks"
      ],
      "properties": {
        "executables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,31}$"
              },
              "path": {
                "$ref": "#/$defs/relativePath"
              }
            }
          }
        },
        "checks": {
          "description": "Commands RAST runs (no shell) after extraction and again from the final location. The first is the version check.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "executable",
              "expect"
            ],
            "properties": {
              "executable": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "expect": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            }
          }
        },
        "mirror": {
          "description": "For an SDK that writes into its own folder while it runs (Flutter): each user runs it from a mirror in ~/.cache/rast-sdk/<id>-<version>, built on first use by launchers the installer generates in .rast-mirror/ (command links and checks use them). The mirror has real folders and links to the shared read-only files; small files (under 1 MiB) directly inside each `copy` folder and anywhere below each `copyTree` folder are copied. Executable paths must then be plain paths too.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "copy": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/plainPath"
              }
            },
            "copyTree": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/plainPath"
              }
            }
          }
        },
        "bundled": {
          "description": "Tools shipped inside the artifact, as found in it (e.g. npm).",
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            }
          }
        },
        "extensions": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48
          }
        },
        "env": {
          "description": "Environment hints for a shell that uses the runtime; values may use the {root} placeholder for the installed prefix. The installer never sets these.",
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^\\{root\\}(/[^\\s]+)?$"
          }
        },
        "pathDirs": {
          "description": "Directories a shell should prepend to PATH, relative to the installed prefix; '.' is the prefix itself (Bun/Deno/.NET put their command at the archive root). Absent means [\"bin\"].",
          "type": "array",
          "maxItems": 8,
          "items": {
            "anyOf": [
              {
                "const": "."
              },
              {
                "$ref": "#/$defs/relativePath"
              }
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "url",
          "sha256",
          "size",
          "format",
          "provenance"
        ],
        "properties": {
          "target": {
            "enum": [
              "linux-x86_64",
              "linux-aarch64"
            ]
          },
          "url": {
            "$ref": "#/$defs/httpsUrl"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483648
          },
          "format": {
            "description": "tar.gz/tar.xz/zip archive, or phar: a verified single-file PHP phar that is written read-only and never executed at install time.",
            "enum": [
              "tar.gz",
              "tar.xz",
              "zip",
              "phar"
            ]
          },
          "stripComponents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "phar": {
            "description": "Only with format \"phar\": where the verified phar file is written inside the prefix. The runtime executables (which must be bin/<name>) are generated by the installer as shell wrappers running `php \"<prefix>/<path>\" \"$@\"`.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$"
              }
            }
          },
          "archives": {
            "description": "Additional archives extracted into the same prefix after the primary archive (multi-component runtimes such as Rust: rust-std, cargo, rustfmt, clippy).",
            "type": "array",
            "maxItems": 7,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "sha256",
                "size",
                "format"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "url": {
                  "$ref": "#/$defs/httpsUrl"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483648
                },
                "format": {
                  "enum": [
                    "tar.gz",
                    "tar.xz",
                    "zip"
                  ]
                },
                "stripComponents": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                }
              }
            }
          },
          "requires": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "glibc": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
              },
              "notes": {
                "type": "string",
                "maxLength": 500
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "source"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "upstream",
                  "built"
                ]
              },
              "source": {
                "$ref": "#/$defs/httpsUrl"
              },
              "sourceSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "verification": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "buildUrl": {
                "$ref": "#/$defs/httpsUrl"
              },
              "attestationUrl": {
                "$ref": "#/$defs/httpsUrl"
              }
            }
          }
        }
      }
    },
    "app": {
      "description": "type app: the desktop app (its window module) and, optionally, the server program RAST runs and forwards apiPrefix to.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "window"
      ],
      "properties": {
        "id": {
          "description": "Desktop app id (windows, access rules, icons).",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry",
            "sdk"
          ],
          "properties": {
            "entry": {
              "description": "ES module whose default export is { mount(ctx, sdk) }.",
              "$ref": "#/$defs/relativePath",
              "pattern": "\\.js$"
            },
            "styles": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/relativePath",
                "pattern": "\\.css$"
              }
            },
            "sdk": {
              "description": "Window SDK version the module is built against.",
              "enum": [
                1
              ]
            },
            "singleton": {
              "type": "boolean"
            },
            "adminOnly": {
              "type": "boolean"
            },
            "defaultSize": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "w",
                "h"
              ],
              "properties": {
                "w": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 4000
                },
                "h": {
                  "type": "integer",
                  "minimum": 150,
                  "maximum": 3000
                }
              }
            },
            "minSize": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "w",
                "h"
              ],
              "properties": {
                "w": {
                  "type": "integer",
                  "minimum": 200,
                  "maximum": 4000
                },
                "h": {
                  "type": "integer",
                  "minimum": 150,
                  "maximum": 3000
                }
              }
            }
          }
        },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "hostApi",
            "apiPrefix",
            "eventPrefix"
          ],
          "properties": {
            "executable": {
              "$ref": "#/$defs/relativePath"
            },
            "hostApi": {
              "description": "Host API version the server speaks.",
              "enum": [
                1
              ]
            },
            "apiPrefix": {
              "description": "/api/<name>: requests below it go to the server.",
              "type": "string",
              "pattern": "^/api/[a-z0-9][a-z0-9-]{0,31}$"
            },
            "eventPrefix": {
              "description": "Prefix of the live event kinds and audit actions it may use, like \"ai.\".",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,31}\\.$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 2048
    },
    "relativePath": {
      "description": "Relative path inside the package: no leading slash, no '.' or '..' components, no backslashes.",
      "type": "string",
      "maxLength": 255,
      "pattern": "^(?!/)(?!.*\\\\)(?!(.*/)?\\.{1,2}(/|$))(?!.*//).+$"
    },
    "plainPath": {
      "description": "Relative path of [A-Za-z0-9._+-] components (no shell syntax), not inside .rast-mirror.",
      "type": "string",
      "maxLength": 200,
      "pattern": "^(?!\\.rast-mirror(/|$))(?!(.*/)?\\.{1,2}(/|$))[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "runtime"
          }
        }
      },
      "then": {
        "required": [
          "runtime"
        ],
        "not": {
          "required": [
            "app"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "app"
          }
        }
      },
      "then": {
        "required": [
          "app"
        ],
        "not": {
          "required": [
            "runtime"
          ]
        }
      }
    }
  ]
}
