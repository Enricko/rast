# RAST configuration file — /etc/rast/rast.toml
#
# Every setting is optional; the built-in defaults are shown below. Values are
# loaded once at startup: run `systemctl restart rast.service` after editing.
#
# Precedence (lowest to highest):
#   built-in defaults  <  this file  <  RAST_* environment variables  <  CLI flags
#
# Environment variables may also be placed in /etc/rast/rast.env (mode 0600
# root:rast), which rast.service loads when present. See docs/CONFIGURATION.md
# for the full reference, validation ranges and examples.
#
# Unknown keys are rejected at startup so that typos never go unnoticed; run
# `rast doctor` to validate the resulting configuration.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Listen address. Keep it on loopback when a reverse proxy terminates TLS.
# env: RAST_BIND
bind = "127.0.0.1:8720"

# Canonical public URL (no trailing slash needed). Required in production:
# it drives the Secure cookie flag, login redirects and links.
# Must start with http:// or https://.
# env: RAST_PUBLIC_URL
# public_url = "https://rast.example.com"

# Reverse proxies whose X-Forwarded-For / CF-Connecting-IP headers are trusted.
# CIDR notation is required; bare IP addresses are rejected. Only list proxies
# you control — otherwise clients could spoof their address.
# env: RAST_TRUSTED_PROXIES (comma separated)
trusted_proxies = []
# trusted_proxies = ["127.0.0.1/32", "::1/128"]

# Honour forwarding headers at all. Default: automatic — enabled when
# trusted_proxies is non-empty. Set explicitly only if you know why.
# env: RAST_TRUST_FORWARDED_HEADERS
# trust_forwarded_headers = true

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Database, backups, managed applications and key material. Must be on a local
# filesystem with working SQLite locking (no NFS/SMB/CIFS).
# env: RAST_DATA_DIR
data_dir = "/var/lib/rast"

# User homes, shared folders and the recycle bin.
# Recommended: a separate volume; never set it inside data_dir.
# env: RAST_STORAGE_DIR
storage_dir = "/srv/rast"

# Unix socket of the privileged Docker worker. The directory is created by
# rast-worker.service (RuntimeDirectory) and removed when it stops.
# env: RAST_WORKER_SOCKET
worker_socket = "/run/rast/worker.sock"

# ---------------------------------------------------------------------------
# Sessions and authentication
# ---------------------------------------------------------------------------

# Sliding session lifetime in hours (1–8760). The absolute cap is 30 days.
# env: RAST_SESSION_TTL_HOURS
session_ttl_hours = 168

# Force the Secure cookie attribute. Default: automatic — true when public_url
# is https://. Leave unset unless you terminate TLS in an unusual way.
# env: RAST_SECURE_COOKIES
# secure_cookies = true

# Require `rast setup-token` before the web-based first-run setup is allowed.
# CLI account creation (`rast user create-admin`) always works. Recommended for
# any internet-reachable instance.
# env: RAST_SETUP_TOKEN_REQUIRED
setup_token_required = false

# ---------------------------------------------------------------------------
# Storage, uploads and quotas
# ---------------------------------------------------------------------------

# Maximum size of a single uploaded file in bytes (1 MiB – 1 TiB).
# Keep reverse-proxy body limits at or above this value.
# env: RAST_MAX_UPLOAD_BYTES
max_upload_bytes = 10737418240

# Default per-user quota in bytes (0 = unlimited). New accounts only; existing
# quotas are changed per user in the UI/CLI.
# env: RAST_DEFAULT_QUOTA_BYTES
default_quota_bytes = 21474836480

# ---------------------------------------------------------------------------
# Database and background jobs
# ---------------------------------------------------------------------------

# SQLite connection pool size (1–64). 8 is plenty for a home server.
# env: RAST_DB_MAX_CONNECTIONS
db_max_connections = 8

# Concurrent background jobs (1–8): copies, moves, deletes, backups, deploys.
# env: RAST_JOB_CONCURRENCY
job_concurrency = 2

# File Station shows the server's own file system ("Root file system") to
# super administrators: browse, upload, download, rename, copy, move and
# delete anywhere, as root. Set to false to remove it for everyone.
# env: RAST_FILES_ROOT_ENABLED
files_root_enabled = true

# ---------------------------------------------------------------------------
# Monitoring and logging
# ---------------------------------------------------------------------------

# Resource monitor sampling interval in seconds (1–300).
# env: RAST_MONITOR_INTERVAL_SECS
monitor_interval_secs = 5

# Log level written to stderr/journald: error, warn, info, debug, trace.
# RUST_LOG, when set, overrides this at runtime.
# env: RAST_LOG_LEVEL
log_level = "info"

# ---------------------------------------------------------------------------
# Optional Docker integration
# ---------------------------------------------------------------------------

# Enable the Applications app (Docker Compose deployments). Requires Docker and
# rast-worker.service; the server itself never accesses the Docker socket.
# env: RAST_DOCKER_ENABLED
docker_enabled = false

# ---------------------------------------------------------------------------
# Native Linux apps (Xpra)
# ---------------------------------------------------------------------------
# Newly installed desktop apps run natively on the server, one shared Xpra
# seamless session per RAST user (see docs/INSTALL.md "Native Linux apps
# (Xpra)"). Needs rast-native.service (root), rast-linux.slice and Xpra.
# Set to false to keep installing legacy Docker-backed apps instead.
# Native apps run in one shared Xpra seamless session per person; every remote
# top-level window becomes its own RAST window. The remote desktop itself is
# never rendered (no viewer window, no Xpra toolbar or background).
# env: RAST_NATIVE_ENABLED
native_enabled = true
# Offer the Linux apps workflow at all (default: on). Set to false to
# quarantine the whole feature — native and legacy Docker-backed installs —
# while keeping its implementation in the binary.
# env: RAST_LINUX_APPS_ENABLED
linux_apps_enabled = true

# ---- Terminal (native PTY shells) ----------------------------------------
# Interactive shells run as the mapped per-user identity through the native
# helper (rast-native.service) — no Docker, Xpra or graphical session needed.
# Administrators keep access and get a root shell on this server by default;
# ordinary accounts are denied until a group grant allows the "terminal"
# application and always run as their unprivileged rast-u<id> identity.
# env: RAST_TERMINAL_ENABLED
terminal_enabled = true
# Super administrators get a real root shell (full server access, HOME=/root).
# Set to false to give them the mapped unprivileged identity, like everyone
# else (administrators and users never get a root shell).
# env: RAST_TERMINAL_ADMIN_ROOT
terminal_admin_root = true
# Run the super administrators' terminals as this Linux login account (a member of
# sudo, admin or wheel) instead of root: a login shell with that account's own
# environment, exactly like its SSH login; use sudo for root.
# env: RAST_TERMINAL_ADMIN_ACCOUNT
# terminal_admin_account = "alice"
# Extra directories at the end of an administrator root shell's PATH, for
# tools installed in another account's home (root runs whatever is in them).
# env: RAST_TERMINAL_PATH_EXTRA (colon separated)
# terminal_path_extra = ["/home/alice/.local/bin"]
# Maximum concurrent terminals per account.
# env: RAST_TERMINAL_MAX_SESSIONS
terminal_max_sessions = 8
# Minimum time a terminal without a viewer is kept (seconds).
# env: RAST_TERMINAL_GRACE_SECONDS
terminal_grace_seconds = 30
# A terminal keeps running when the page is reloaded or the browser is closed.
# Close it after this many minutes without output while nobody views it
# (0 = right after the grace period).
# env: RAST_TERMINAL_IDLE_MINUTES
terminal_idle_minutes = 1440
# Per-terminal systemd limits.
# env: RAST_TERMINAL_MEMORY_MB
terminal_memory_mb = 1024
# env: RAST_TERMINAL_CPUS
terminal_cpus = 2
# env: RAST_TERMINAL_TASKS
terminal_tasks = 512
# env: RAST_NATIVE_HELPER_SOCKET
native_helper_socket = "/run/rast/native.sock"
# env: RAST_LINUX_XPRA_BIN
linux_xpra_bin = "/usr/bin/xpra"
# First uid of the per-user Linux identities: uid = linux_uid_base + user id.
# Must not overlap local accounts or systemd's dynamic uid range.
# env: RAST_LINUX_UID_BASE
linux_uid_base = 200000
# How long a person's session stays alive after its last app exits
# (0 = stop at once). A page reload reconnects within this window.
# env: RAST_LINUX_IDLE_MINUTES
linux_idle_minutes = 15
# cgroup limits: one person's graphical session ...
# env: RAST_LINUX_SESSION_MEMORY_MB / _CPUS / _TASKS
linux_session_memory_mb = 4096
# linux_session_cpus defaults to a quarter of the server's CPUs (2-8)
linux_session_tasks = 2048
# ... and one native application.
# env: RAST_LINUX_APP_MEMORY_MB / _CPUS / _TASKS
linux_app_memory_mb = 2048
linux_app_cpus = 2
linux_app_tasks = 1024
# Free memory kept in reserve when a new application is admitted.
# env: RAST_LINUX_ADMISSION_RESERVE_MB
linux_admission_reserve_mb = 1024

# ---- Applications installed outside the App Center ----------------------
# Scan for desktop applications RAST did not install (XDG .desktop entries,
# AppImages, portable programs and applications an external installer put in a
# managed app profile) and list them in App Center as a separate inventory.
# linux_discovery_enabled = true
# Extra roots to scan (treated as system-wide entries). The standard
# /usr/share/applications, /usr/local/share/applications, /opt and per-identity
# XDG/Applications directories are always scanned.
# linux_discovery_roots = ["/srv/applications"]
# Policy for system-wide discoveries: "approval" (default; administrators
# approve before ordinary accounts may launch them), "auto" (usable at once) or
# "hidden" (recorded, never shown to ordinary accounts).
# linux_discovery_system_apps = "approval"
# Seconds between background rescans (default 300; 0 disables the timer, the
# App Center "Rescan applications" button always works).
# linux_discovery_interval_seconds = 300

# ---- Native session performance profile -----------------------------------
# Adaptive profile for every person's shared Xpra session. "balanced" keeps
# Xpra's own adaptive defaults (quality/speed chosen from load). "responsive"
# pins the lowest latency for typing and general interaction, "media" favours
# smooth video, "quality" favours sharp text and images. Explicit quality/
# speed/scaling settings below override the profile.
# env: RAST_LINUX_PROFILE
linux_profile = "balanced"
# Optional fixed settings (1-100; video_scaling 0-100). Unset = profile value.
# env: RAST_LINUX_QUALITY
# linux_quality = 60
# env: RAST_LINUX_MIN_QUALITY
# linux_min_quality = 20
# env: RAST_LINUX_SPEED
# linux_speed = 60
# env: RAST_LINUX_MIN_SPEED
# linux_min_speed = 30
# env: RAST_LINUX_VIDEO_SCALING
# linux_video_scaling = 50
# env: RAST_LINUX_AV_SYNC
# linux_av_sync = true
# Preferred encoding; unset = Xpra automatic. One of: h264, vp8, vp9, webp,
# jpeg, rgb (browser clients cannot decode every codec).
# env: RAST_LINUX_ENCODING
# linux_encoding = "h264"

# Headless X server for native sessions: "auto" uses linux_xvfb_command when it
# is executable and falls back to the bundled Xvfb, "software" always uses
# Xvfb, "custom" expects the command below (still falls back to Xvfb at start
# if it is missing, so a bad command never bricks sessions).
# env: RAST_LINUX_DISPLAY_BACKEND
# auto | software | gpu | custom (default: auto). "auto" prefers a verified
# NVIDIA GPU display when the helper can start one, and falls back to Xvfb when
# the real OpenGL probe fails. "gpu" is strict: the session fails instead of
# silently using software rendering. "custom" uses linux_xvfb_command.
# linux_display_backend = "auto"
# Optional wrapper script that starts an alternative headless X server (a
# GPU-backed Xorg configuration, validated as described in
# docs/GPU-ACCELERATION.md). It replaces `Xvfb` in `xpra start --xvfb=...`.
# env: RAST_LINUX_XVFB_COMMAND
# linux_xvfb_command = "/usr/local/sbin/rast-xorg-gpu"
# Pre-warm each eligible person's graphical session after sign-in so the first
# application launch does not pay the ~12 s cold Xpra start. Off by default:
# it keeps one idle session per signed-in native-app user (roughly 150-250 MiB)
# until the normal idle cleanup reclaims it.
# env: RAST_LINUX_PREWARM
# linux_prewarm = true

# ---------------------------------------------------------------------------
# App Center
# ---------------------------------------------------------------------------

# Put the runtimes chosen with "Make default" on every login shell's PATH,
# ahead of /usr/bin, so `go`, `node`, `php` and `python3` in a terminal run
# them. Runtimes the system already has stay installed and are used again
# when you choose "Use the system version". Apply a change with
# `sudo rast packages path sync` (the installer and `rast update` run it).
# env: RAST_PACKAGES_SHELL_PATH
packages_shell_path = true

# Also link those defaults into /usr/local/bin, so sudo, systemd services and
# scripts run them too, not only login shells. Files installed by apt are never
# changed. A command installed by hand in /usr/local/bin (for example a manual
# Node.js) is moved aside to /usr/local/bin/.rast-displaced.<name>, and it is
# put back when you choose "Use the system version" or uninstall. Note: root
# then runs files the rast service account can change. Needs
# packages_shell_path. Apply with `sudo rast packages path sync`.
# env: RAST_PACKAGES_SYSTEM_WIDE
packages_system_wide = false
