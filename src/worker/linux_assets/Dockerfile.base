# RAST Linux apps: the shared desktop layer every app image starts from.
FROM ghcr.io/linuxserver/baseimage-selkies@sha256:d5e900e9dbc7e0ec830758355cbb80f0b773ce55da82f59e7785298a510bc0f6
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libsecret-1-0 fonts-liberation tint2 wmctrl \
 && rm -rf /var/lib/apt/lists/*
COPY rast/ /rast/
COPY s6/ /etc/s6-overlay/s6-rc.d/
COPY custom-cont-init.d/ /custom-cont-init.d/
