# Rust build output
/target/
**/*.rs.bk

# Frontend build output (generated by `pnpm --dir frontend build`)
/frontend/dist/
/frontend/node_modules/

# Local runtime data and secrets
/data/
*.db
*.db-wal
*.db-shm
*.key
.env
.env.local
*.log

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.swp

# Node
/frontend/node_modules/
/frontend/dist/
npm-debug.log*

# Local verification artifacts (harnesses and results are committed; large
# screenshots and installed npm packages are not).
scripts/xpra-poc/node_modules/
scripts/xpra-poc/screenshots/
scripts/xpra-poc/screenshots-real/
scripts/xpra-poc/*.log
tests/e2e/node_modules/
tests/e2e/screenshots/
tests/e2e/results/latest/

# Manual terminal E2E outputs (generated by tests/e2e/terminal-native.mjs)
tests/e2e/terminal-native-*.png
tests/e2e/terminal-native-result.json

# Production deployment verification screenshots (manual)
tests/e2e/prod-*.png

# Local admin-root Terminal verification screenshot
tests/e2e/dev-*.png
